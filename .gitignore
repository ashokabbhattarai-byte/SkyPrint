# Monorepo dependencies
node_modules/
.pnp
.pnp.*

# Testing & coverage
coverage/

# Next.js (monorepo-wide)
.next/
out/
next-env.d.ts

# NestJS / TypeScript build outputs
dist/
build/
*.tsbuildinfo

# Environment & secrets (commit .env.example templates only)
.env
.env.*
!.env.example

# Temporary JSON store & future PostgreSQL local volumes / dumps
apps/api/data/
postgres-data/
pgdata/
*.dump
*.sql.gz

# Raw media / source assets & unnecessary WebP files (keep active animations & UI WebPs)
assets/
*.webp
!apps/web/public/sequences/printing-desktop/*.webp
!apps/web/public/sequences/printing-mobile/*.webp
!apps/web/public/images/*.webp
!apps/web/public/images/gallery/*.webp

# Logs & OS files
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Deployment / tooling caches
.vercel
.turbo
