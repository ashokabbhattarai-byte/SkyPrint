{
  "name": "skyprint-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @skyprint/web dev",
    "dev:api": "pnpm --filter @skyprint/api dev",
    "build": "pnpm --filter @skyprint/shared build && pnpm --filter @skyprint/api build && pnpm --filter @skyprint/web build",
    "lint": "pnpm --filter @skyprint/web lint",
    "typecheck": "pnpm --filter @skyprint/shared build && pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
